# Instanton Campus settings. Copy to .env.local and fill in. NEVER commit .env.local (it is git-ignored).
# Values marked SECRET must never be shared, pasted in chat, or put in the code.

# --- Database (Supabase) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # SECRET
SUPABASE_DB_URL=                      # SECRET: session pooler connection string, for `npm run db:migrate`
NEXT_PUBLIC_AUTH_MODE=real            # "demo" = sample data, no accounts
PLATFORM_FILE=                        # optional: where admin settings are kept (default data/platform.json)
# Test project (used by `npm run check:real`, `test:accounts`, `db:migrate -- test`)
TEST_SUPABASE_URL=
TEST_SUPABASE_PUBLISHABLE_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=       # SECRET
TEST_SUPABASE_DB_URL=                 # SECRET

# --- Site ---
NEXT_PUBLIC_SITE_URL=                 # e.g. https://classbari.app
ADMIN_TOKEN=                          # SECRET: opens /admin
CRON_SECRET=                          # SECRET: for /api/notify/run
BEHIND_CLOUDFLARE=                    # 1 when the site is behind Cloudflare (trusts its visitor address)
RATE_LIMIT_OFF=                       # 1 only for local tests
NEXT_PUBLIC_JITSI_DOMAIN=             # optional: own Jitsi server; default meet.jit.si
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
ALERT_WEBHOOK_URL=                    # SECRET, optional: error alerts
LEADS_WEBHOOK_URL=                    # SECRET, optional: new enquiry alerts

# --- AI (a model shows only when its provider's key is set) ---
ANTHROPIC_API_KEY=                    # SECRET
GEMINI_API_KEY=                       # SECRET
DASHSCOPE_API_KEY=                    # SECRET (Qwen)
OPENAI_API_KEY=                       # SECRET
OPENROUTER_API_KEY=                   # SECRET: one key for the 100B+ Bangla models (DeepSeek, Qwen3 235B/397B, GLM, GPT-OSS); turn on Zero Data Retention in its privacy settings
GEMINI_BASE_URL=
DASHSCOPE_BASE_URL=                   # default: Singapore compatible-mode endpoint
OPENAI_BASE_URL=
AI_CHAT_MODEL=
AI_PDF_MODEL=
AI_DAILY_TOKENS=                      # staff previews
AI_MONTHLY_BUDGET_USD=30              # whole site
AI_FREE_WINDOW_USD=0.004              # free plan, per 12 hours
USD_TO_BDT=122                        # monthly pack caps = price × (1 − 40% margin) ÷ this
OCR_SERVICE_URL=http://127.0.0.1:8000 # the Python service (npm run ocr): saved-answer matching, handwriting
AI_CACHE_SIMILARITY=
AI_CACHE_TIMEOUT_MS=
IMAGE_FLAG_AT=
IMAGE_CHECK_TIMEOUT_MS=

# --- Notifications ---
FIREBASE_SERVICE_ACCOUNT=             # path to the Firebase service-account JSON (the file is SECRET, git-ignored)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=                    # SECRET
NOTIFY_TIMER=

# --- SMS ---
SMS_API_URL=
SMS_API_KEY=                          # SECRET
SMS_SENDER_ID=

# --- Payments (manual bKash / Nagad with TrxID) ---
PAY_BKASH_NUMBER=
PAY_NAGAD_NUMBER=
